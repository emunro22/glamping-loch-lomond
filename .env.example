# ---------- Database (Neon / Vercel Postgres) ----------
DATABASE_URL="postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# ---------- Vercel Blob (photo uploads) ----------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# ---------- Admin portal ----------
# Password used to sign in at /admin/login
ADMIN_PASSWORD="change-me-to-something-long"
# Random 32+ char string used to sign the session cookie
AUTH_SECRET="run: openssl rand -base64 32"

# ---------- Resend (contact form emails) ----------
RESEND_API_KEY="re_xxxxxxxxxxxx"
CONTACT_TO_EMAIL="info@glampinglochlomond.co.uk"
CONTACT_FROM_EMAIL="Glamping Loch Lomond <bookings@glampinglochlomond.co.uk>"

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL="https://www.glampinglochlomond.co.uk"
